# AKURI Configuration Example
# Copy this file to .env and modify the values as needed

# REQUIRED: Path to the documents folder for indexing and search
# This is the main configuration for customizing where AKURI looks for documents
# The application will fail to start without this variable
AKURI_DOCS_PATH=/path/to/your/akuri/documents

# OPTIONAL: Logging level (error, warn, info, http, debug)
# Default: 'info' for production, 'debug' for development
# LOG_LEVEL=info
# LOG_LEVEL=debug

# Example configurations:
# AKURI_DOCS_PATH=/home/user/my-documents
# AKURI_DOCS_PATH=/var/www/docs
# AKURI_DOCS_PATH=./my-local-docs
# AKURI_DOCS_PATH=/mnt/0e67f549-8f2b-4fee-92ea-605bc0fd16ea/MULTIROOT/AKURI